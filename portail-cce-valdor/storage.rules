rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Core Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is coordinator via Firestore (Optional, but Storage rules can't easily access Firestore in all tiers/versions efficiently. 
    // Usually we rely on simple auth checks or Custom Claims. 
    // For this implementation, we will stick to basic Auth + Path Ownership patterns).

    match /{allPaths=**} {
      // 1. Read: Authenticated users can read any file (internal portal)
      allow read: if isAuthenticated();

      // 2. Write (Create): Authenticated users can upload (e.g. adding documents)
      allow create: if isAuthenticated();
      
      // 3. Update/Delete: Only Coordinator OR User owning the file (if paths structured by user)
      // Since our paths are flat-ish (documents/timestamp_name.ext), we can't easily check 'owner' unless we use metadata or path names.
      // documentsAPI uploads to: documents/{timestamp}_{filename}
      // For now, restricting DELETE to Coordinator is safest to prevent malicious wipes.
      // But users need to delete their own uploads?
      // Without metadata in rules, we can't check 'uploadedBy'.
      // Compromise: Coordinator only for DELETE/UPDATE. Users can only CREATE.
      allow update, delete: if isAuthenticated() && (
        // Allow coordinator (requires custom claims or we rely on client behavior if rules are limited)
        // Storage rules don't support get() from Firestore easily.
        // We will restrict to CREATE only for normal users, DELETE for no one via SDK unless we trust auth.
        // Wait, 'documentsAPI' delete runs from Client. If I block delete, users can't delete documents they just erroneously uploaded.
        // Let's rely on Auth for now but note the limitation.
        request.auth != null // Ideally: hasRole('coordinator') via Custom Claims
      );
    }
    
    // Specific Rules for Signatures
    match /signatures/{userId}/{fileName} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
