rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isCoordinator() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'coordinator';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Members collection
    match /members/{userId} {
      allow read: if isAuthenticated();
      // Allow authenticated users to manage members (create/update/delete)
      // Ideally restricted to Coordinator, but loosening for dev/functionality
      allow write: if isAuthenticated();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Temporary: allow any auth user
      
      // Tasks sub-collection
      match /tasks/{taskId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Meetings collection
    match /meetings/{meetingId} {
      // Allow public read for approval workflow (magic links)
      // All authenticated users can read, and public can read for approval pages
      allow read: if true;
      // Temporarily allow any authenticated user to write to meetings to unblock development
      allow write: if isAuthenticated(); 
      
      // Convocations sub-collection (Phase 2 - with RSVP)
      // PUBLIC read/write allowed for magic link RSVP confirmations (no auth required)
      match /convocations/{convocationId} {
        allow read, write: if true;  // Magic link RSVP workflow requires public access
      }
      
      // Avis de convocation sub-collection (Phase 1)
      match /avis_convocations/{avisId} {
        allow read, write: if isAuthenticated();
      }
      
      // PV Versions sub-collection (for version history)
      match /pv_versions/{versionId} {
        allow read, write: if isAuthenticated();
      }
      
      // Approval tokens - PUBLIC READ for magic link validation
      match /approval_tokens/{tokenId} {
        allow read: if true;  // Public read for magic link validation
        allow write: if isAuthenticated();
      }
      
      // Approvals sub-collection - PUBLIC for magic link workflow
      match /approvals/{approvalId} {
        allow read, write: if true;  // Public read/write for approval workflow via magic link
      }
    }

    // Council Recommendations collection
    match /council_recommendations/{recommendationId} {
      allow read: if isAuthenticated();
      // Allow any auth user to create/manage for now (dev mode)
      allow write: if isAuthenticated();
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Any authenticated user can upload
      // Only owner or coordinator can modify/delete
      allow update, delete: if isCoordinator() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // Activity Log collection
    match /activity_log/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Any authenticated user can log activities
      allow update, delete: if false; // Logs are immutable
    }
  }
}
