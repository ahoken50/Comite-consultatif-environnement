rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isCoordinator() {
      return isAuthenticated() && getUserData().role == 'coordinator';
    }
    
    function isPresident() {
        return isAuthenticated() && getUserData().role == 'president';
    }

    function isElectedOfficial() {
        return isAuthenticated() && getUserData().role == 'elected_official';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Collections Rules ---

    // Users Collection
    // - Authenticated user can read/write their own profile.
    // - Coordinator can read/write ANY profile (for role management).
    // - All authenticated users can read basic info of others (useful for lists),
    //   but strictly speaking, we might want to restrict this. For now, open read is safer for UI.
    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated() && isOwner(userId); // Sign up
      allow update: if isCoordinator() || isOwner(userId);
      allow delete: if isCoordinator();
    }

    // Members Collection (CCE Directory)
    // - Read: All authenticated.
    // - Create/Delete: Coordinator only.
    // - Update: Coordinator OR User updating their own linked profile (if we implement that link).
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator(); 
    }

    // Projects Collection
    // - Read: All authenticated.
    // - Create/Delete: Coordinator only.
    // - Update: Coordinator only (Strict RBAC). Assiging tasks allows implicit write to 'Tasks' subcollection.
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator();
      
      // Tasks Sub-collection
      // - Read: All.
      // - Write: Coordinator OR Assignee.
      match /tasks/{taskId} {
        allow read: if isAuthenticated();
        allow write: if isCoordinator() || (isAuthenticated() && request.resource.data.assigneeId == request.auth.uid);
      }
    }

    // Meetings Collection
    // - Read: All (including public for magic links via subcollections logic if needed, but meeting doc itself usually auth).
    // - Exceptions for Public Approval/RSVP pages: They read specific tokens, not the full meeting doc usually.
    // - Write: Coordinator only.
    // - Update: Coordinator only.
    match /meetings/{meetingId} {
      allow read: if true; // Keeping open for magic links, or restrict if possible.
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator() || 
                     (isPresident() && request.resource.data.presidentSignature != null) ||
                     (isElectedOfficial() && request.resource.data.electedOfficialSignature != null);
      
      // Subcollections (Agenda, RSVP...)
      match /agendaItems/{itemId} {
         allow read: if isAuthenticated();
         allow create: if isAuthenticated(); // Members can propose
         allow update, delete: if isCoordinator() || (isAuthenticated() && resource.data.proposedBy == request.auth.uid);
      }
    }

    // Resolutions & Recommendations
    // - Read: All authenticated.
    // - Write: Coordinator only.
    // - Elected Official can update Recommendations (add notes/print).
    match /resolutions/{resId} {
      allow read: if isAuthenticated();
      allow write: if isCoordinator();
    }

    match /council_recommendations/{recId} {
        allow read: if isAuthenticated();
        allow create, delete: if isCoordinator();
        allow update: if isCoordinator() || isElectedOfficial();
    }

    // Documents
    // - Read: All authenticated.
    // - Create: All authenticated (Upload).
    // - Delete: Coordinator OR Owner.
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isCoordinator() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // Activity Logs
    // - Read: Authenticated.
    // - Create: System (Authenticated users trigger it).
    // - No delete/update.
    match /activity_log/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
    }
  }
}
